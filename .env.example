# Local-only 32-byte AES master key encoded as 64 hexadecimal characters.
# Generate: openssl rand -hex 32. Never reuse this key in production.
PRIVACYVAULT_MASTER_KEY=
PRIVACYVAULT_BLIND_INDEX_KEY=
PRIVACYVAULT_PSEUDONYM_KEY=
PRIVACYVAULT_JWT_SECRET=

POSTGRES_DB=privacyvault
POSTGRES_USER=privacyvault
POSTGRES_PASSWORD=replace-with-a-strong-local-password
DB_URL=jdbc:postgresql://localhost:5432/privacyvault
DB_USERNAME=privacyvault
DB_PASSWORD=replace-with-a-strong-local-password

KEY_PROVIDER=env
AWS_REGION=eu-central-1
AWS_KMS_ROTATION_EPOCH=v1
JWT_ISSUER=privacy-vault
CORS_ALLOWED_ORIGINS=http://localhost:3000
ERASURE_GRACE_DAYS=14
SWAGGER_ENABLED=true
SERVER_PORT=8080
