# Copy to a host-only .env.production file and replace every example value.
# Keep secret material in separate files under SECRET_DIR, not in this file.
APP_IMAGE_TAG=replace-with-release-version
SECRET_DIR=/etc/privacyvault/secrets
POSTGRES_DB=privacyvault
POSTGRES_USER=privacyvault
AWS_REGION=eu-central-1
AWS_KMS_ROTATION_EPOCH=v1
CORS_ALLOWED_ORIGINS=https://app.example.com
JWT_ISSUER=privacy-vault
ERASURE_GRACE_DAYS=14
API_BIND_ADDRESS=127.0.0.1
API_BIND_PORT=8080
POSTGRES_MEMORY_LIMIT=1g
API_MEMORY_LIMIT=1g
API_CPU_LIMIT=2
