server {
    listen 80;
    server_name privacyvault.example.com;
    return 301 https://privacyvault.example.com$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name privacyvault.example.com;

    ssl_certificate /etc/letsencrypt/live/privacyvault.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/privacyvault.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $server_name;
        proxy_set_header X-Forwarded-Host $server_name;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Port 443;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
